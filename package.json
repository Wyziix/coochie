    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test -- --ci && npm run test:functions",
    "test:db": "bash scripts/test-db.sh",
    "test:functions": "npx -y deno@2.9.6 test supabase/functions",
    "build:web": "expo export --platform web --clear",
    "deploy:web": "npm run build:web && npx -y wrangler@4.155.0 pages deploy dist --project-name ${CF_PAGES_PROJECT:-lightweightbaby} --branch main --commit-dirty=true",
    "deploy:functions": "npx -y supabase@2.122.0 functions deploy photos --no-verify-jwt --use-api --project-ref gwyymvaxgmpamtiuhoez"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0 <12.0.0"
  }
