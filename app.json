{
  "expo": {
    "name": "LightweightBaby",
    "slug": "lightweightbaby",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lightweightbaby",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lightweightbaby.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lightweightbaby.app"
    },
    "web": {
      "output": "single",
      "favicon": "./public/favicon.png",
      "name": "LightweightBaby",
      "shortName": "LightweightBaby",
      "themeColor": "#0B0D10",
      "backgroundColor": "#0B0D10"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B0D10"
          }
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "LightweightBaby uses your photos to set a profile picture and save progress photos.",
          "cameraPermission": "LightweightBaby uses the camera to take progress photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6E8EFF"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
