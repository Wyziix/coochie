# Edge Function secrets. Never commit real values and never copy these into the app.
# Local:      supabase functions serve --env-file supabase/functions/.env
# Production: supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by Supabase into every Edge Function.

# Claude API (Stage 6+)
ANTHROPIC_API_KEY=

# Open Food Facts contact for its User-Agent (Stage 10, optional)
OFF_CONTACT=

# The app's address, used when OFF_CONTACT / VAPID_SUBJECT are empty (Stage 11,
# set it once you move to your own domain), e.g. https://lightweightbaby.app
SITE_URL=

# Web push (Stage 11): made by `node scripts/generate-vapid-keys.mjs <email>`,
# which writes them to .vapid.env. Send that file with
# `supabase secrets set --env-file .vapid.env`; don't paste the key here.
# VAPID_KEYS=
# VAPID_SUBJECT=mailto:you@example.com
