# Response headers for Cloudflare Pages (expo export copies this into dist/).
# Nothing here affects Google login (full-page redirect), Supabase calls (CORS)
# or photo uploads (Edge Function, CORS).
#
# No cross-origin isolation (COOP/COEP): offline data on web lives in
# IndexedDB, which doesn't need it. Turning on the strict `require-corp` form
# (the only one iPhone Safari supports) would block cross-origin images such as
# Google profile pictures and avatars.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()

# File names contain a content hash, so they can be cached forever.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker: always check for a new version.
/sw.js
  Cache-Control: no-cache
