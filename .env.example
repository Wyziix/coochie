# Copy to .env and fill in. Only EXPO_PUBLIC_* values go into the app bundle,
# so nothing secret belongs in this file. Server secrets live in
# supabase/functions/.env.example and are set with `supabase secrets set`.

# Supabase project (Project Settings > API). Use the publishable key
# (sb_publishable_...) or the legacy anon key. Never the service role / secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Sign-In (Stage 1). OAuth client IDs from Google Cloud Console.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
